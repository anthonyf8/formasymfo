{% extends 'base.html.twig' %}

{% block body %}
<section id="list-events">
    <div class="container">
        <div class="row">
            <div class="col-md-10 m-auto">
                <h1 class="fw-bolder" style="color: limegreen;">List all events</h1>
                <div class="row row-cols-1 row-cols-md-2 g-4 mb-5">

                    {% for event in events %}

                        <div class="col">
                            <div class="card h-100">
                                <div class="card-body">
                                    <div class="card-title">
                                        <h5 class="fw-bolder mb-0">
                                            <a href="{{ path('app_show_event', {'id':event.id}) }}"
                                               class="stretched-link text-decoration-none"
                                               style="color: limegreen;">{{event.name}}</a>
                                        </h5>
                                    </div>
                                    <div class="card-text d-flex justify-content-between">
                                        <div>

                                            {% if event.project is not empty %}
                                                <p class="my-0">{{event.project.name}}</p>
                                            {% endif %}

                                            {% if event.organization is not empty %}
                                                <p class="my-0">{{event.organization is not empty ? event.organization|map((o) => o.name)|join(', ') : '-'}}</p>
                                            {% endif %}

                                        </div>
                                        <div>
                                            <p class="mb-0">From <span
                                                        class="fw-semibold">{{event.startAt|date('Y-m-d')}}</span>
                                                to
                                                <span class="fw-semibold">{{event.endAt|date('Y-m-d')}}</span></p>
                                            <p class="my-0 fst-italic">{{event.volunteer|length}} volunteer
                                                yet.</p>
                                            <p class="mt-0">Accessible
                                                : {{event.publish ? 'Yes' : 'No'}}</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    {% else %}

                        <div> There are no events yet...</div>

                    {% endfor %}

                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
